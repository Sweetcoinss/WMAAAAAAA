<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Launcher" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_launcher</item>
        <item name="android:colorAccent">#FFFF7A1A</item>
        <item name="android:statusBarColor">#FF0A0D12</item>
        <item name="android:navigationBarColor">#FF070A0E</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Game" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
